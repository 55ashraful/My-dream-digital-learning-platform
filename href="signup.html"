    <!-- Firebase Scripts -->
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>

    <script>
        const firebaseConfig = {
          apiKey: "AIzaSyB8aEO4CyIP6l4kspuo_sJUMTwUzp0NvzU",
          authDomain: "my-income-d85b2.firebaseapp.com",
          databaseURL: "https://my-income-d85b2-default-rtdb.firebaseio.com",
          projectId: "my-income-d85b2",
          storageBucket: "my-income-d85b2.firebasestorage.app",
          messagingSenderId: "731557596083",
          appId: "1:731557596083:web:0f2c25edd8c87dfcd359c6",
          measurementId: "G-CR12TD3VCJ"
        };
        firebase.initializeApp(firebaseConfig);
        const database = firebase.database();

        document.addEventListener('DOMContentLoaded', () => {
            const menuToggle = document.getElementById('menuToggle');
            const mobileNav = document.getElementById('mobileNav');
            const closeNav = document.querySelector('.close-nav');
            const togglePasswordIcons = document.querySelectorAll('.toggle-password');
            const scrollToTopBtn = document.querySelector('.scroll-to-top');

            if(menuToggle) menuToggle.addEventListener('click', () => mobileNav.classList.add('open'));
            if(closeNav) closeNav.addEventListener('click', () => mobileNav.classList.remove('open'));

            togglePasswordIcons.forEach(icon => {
                icon.addEventListener('click', () => {
                    const targetId = icon.dataset.target;
                    const passwordInput = document.getElementById(targetId);
                    if (passwordInput.type === 'password') {
                        passwordInput.type = 'text';
                        icon.classList.remove('fa-eye');
                        icon.classList.add('fa-eye-slash');
                    } else {
                        passwordInput.type = 'password';
                        icon.classList.remove('fa-eye-slash');
                        icon.classList.add('fa-eye');
                    }
                });
            });

            if(scrollToTopBtn) {
                scrollToTopBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            }

            // সাইনআপ ফর্ম লজিক
            const signupForm = document.getElementById('signupForm');
            if(signupForm) {
                signupForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    
                    const email = document.getElementById('signup-email').value.trim();
                    const whatsapp = document.getElementById('signup-whatsapp').value.trim();
                    const firstName = document.getElementById('signup-fname').value.trim();
                    const lastName = document.getElementById('signup-lname').value.trim();
                    const password = document.getElementById('signup-password').value;
                    const referral = document.getElementById('signup-referral').value.trim();
                    const termsChecked = document.getElementById('terms-checkbox').checked;
                    
                    if (!email || !whatsapp || !firstName || !lastName || !password) {
                        showError('signup-error', 'Please fill in all required fields.'); return;
                    }
                    if (!termsChecked) {
                        showError('signup-error', 'Please accept the Terms of Use and Privacy Policy.'); return;
                    }
                    if (password.length < 6) {
                        showError('signup-error', 'Password must be at least 6 characters long.'); return;
                    }
                    
                    setButtonLoading('signup-btn', true, 'Sign Up <i class="fas fa-arrow-right"></i>');
                    
                    try {
                        // ইমেইল চেক
                        const emailCheck = await database.ref('users').orderByChild('email').equalTo(email).once('value');
                        if (emailCheck.exists()) {
                            showError('signup-error', 'This email is already registered. Please login instead.');
                            setButtonLoading('signup-btn', false, 'Sign Up <i class="fas fa-arrow-right"></i>'); return;
                        }
                        
                        // হোয়াটসঅ্যাপ চেক
                        const whatsappCheck = await database.ref('users').orderByChild('whatsapp').equalTo(whatsapp).once('value');
                        if (whatsappCheck.exists()) {
                            showError('signup-error', 'This WhatsApp number is already registered.');
                            setButtonLoading('signup-btn', false, 'Sign Up <i class="fas fa-arrow-right"></i>'); return;
                        }
                        
                        // ডাটাবেসে সেভ
                        const newUserRef = database.ref('users').push();
                        const userData = {
                            email: email, whatsapp: whatsapp, firstName: firstName, lastName: lastName,
                            password: password, referralCode: referral || '', createdAt: Date.now(), status: 'active', role: 'member'
                        };
                        
                        await newUserRef.set(userData);
                        
                        // সাকসেস পপআপ দেখানো
                        document.getElementById('modal-referral').innerText = referral || "None";
                        document.getElementById('modal-login-id').innerText = whatsapp;
                        document.getElementById('modal-password').innerText = password;
                        document.getElementById('successModal').classList.add('show');

                        document.getElementById('signupForm').reset();
                        
                    } catch (error) {
                        console.error('Signup error:', error);
                        showError('signup-error', 'Registration failed. Please try again later.');
                    }
                    
                    setButtonLoading('signup-btn', false, 'Sign Up <i class="fas fa-arrow-right"></i>');
                });
            }
        });

        function showError(elementId, message) {
            const errorEl = document.getElementById(elementId);
            if (errorEl) { errorEl.textContent = message; errorEl.style.display = 'block'; setTimeout(() => { errorEl.style.display = 'none'; }, 5000); }
        }

        function setButtonLoading(buttonId, isLoading, originalText) {
            const btn = document.getElementById(buttonId);
            if (btn) {
                if (isLoading) { btn.disabled = true; btn.innerHTML = '<span class="loading-spinner"></span> Please wait...'; }
                else { btn.disabled = false; btn.innerHTML = originalText; }
            }
        }
    </script>
